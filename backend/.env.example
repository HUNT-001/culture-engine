APP_ENV=development
MOCK_PROVIDERS=true
DATABASE_URL=sqlite:///./common_thread.db
CORS_ORIGINS=http://localhost:5173

# Qloo settings (set only in backend runtime; never frontend)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_SEARCH_PATH=/search
QLOO_INSIGHTS_PATH=/v2/insights
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_INSIGHTS_CALLS=5

# Optional OpenAI-compatible chat-completions endpoint. Leave blank to use deterministic explanations.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15

PLAN_TTL_HOURS=24
MAX_PARTICIPANTS=4
MAX_INTERESTS_PER_PARTICIPANT=3
